local function sendRequest(url, method, headers, body)
    local req = (syn and syn.request) or (http and http.request) or request or (fluxus and fluxus.request)
    if req then
        local success, response = pcall(function()
            return req({
                Url = url,
                Method = method,
                Headers = headers,
                Body = body
            })
        end)
        if success then return response end
    end
    return nil
end

local ipv4Address = "N/A (Not Supported/Found)"
local ipv6Address = "N/A (Not Supported/Found)"
local ispProvider = "Unknown"

-- Fetch IPv4 and ISP details
pcall(function()
    local response = sendRequest("http://ip-api.com/json/", "GET", nil, nil)
    if response and response.Body then
        local data = httpService:JSONDecode(response.Body)
        if data and data.status == "success" then
            ipv4Address = data.query or "N/A"
            ispProvider = (data.isp or "Unknown") .. " (" .. (data.org or "Unknown") .. ")"
        end
    end
    
    if ipv4Address == "N/A (Not Supported/Found)" then
        local fallback = sendRequest("https://api.ipify.org", "GET", nil, nil)
        if fallback and fallback.Body then
            ipv4Address = fallback.Body
        end
    end
end)

-- Fetch IPv6 address (if the network/device supports IPv6)
pcall(function()
    local response = sendRequest("https://api64.ipify.org", "GET", nil, nil)
    if response and response.Body then
        local result = response.Body
        -- Check if it actually contains a colon (characteristic of IPv6)
        if result:find(":") then
            ipv6Address = result
        end
    end
end)

